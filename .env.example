# =============================================================================
# Dhaka Chronicles — environment variables.
# ALL values are SERVER-ONLY. Never prefix any of them with NEXT_PUBLIC_.
# Copy to .env.local for development; set them in Vercel for production.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Site ---------------------------------------------------------------------
# Public origin, no trailing slash (canonical URLs, sitemaps, OAuth redirects).
SITE_URL=http://localhost:3000
# Language "/" redirects to: bn or en
DEFAULT_LANGUAGE=bn

# --- Scheduled jobs -----------------------------------------------------------
# Supabase Cron sends "Authorization: Bearer <CRON_SECRET>". Min 16 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Cloudflare R2 (media) ----------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Custom public domain for the bucket, e.g. https://media.example.com
R2_PUBLIC_BASE_URL=

# --- Instagram API with Unified Login ---------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta app ID/secret (App settings > Basic) and the Unified Login configuration ID.
INSTAGRAM_CONFIG_ID=
# Must exactly match the redirect URI registered in the Meta app:
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Only this account can be connected:
INSTAGRAM_EXPECTED_USERNAME=dhakachronicles
# Any random string; paste the same value into Meta's webhook "Verify token" field.
# Webhook callback URL: https://dhakachronicles.com/api/instagram/webhook
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# 32 random bytes, base64. Encrypts Instagram tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Optional: AI SEO suggestions (any OpenAI-compatible chat completions API)
AI_SEO_API_URL=
AI_SEO_API_KEY=
AI_SEO_MODEL=
