# All Supabase values are SERVER-ONLY. Do NOT prefix them with NEXT_PUBLIC_,
# so they are never bundled into browser JavaScript.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public site URL (used for canonical URLs, sitemaps, OAuth redirects)
SITE_URL=http://localhost:3000

# Shared secret Supabase Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate-a-long-random-string

# 32-byte base64 key for encrypting Instagram tokens at rest
TOKEN_ENCRYPTION_KEY=
